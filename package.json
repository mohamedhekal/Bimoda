{
  "name": "bimoda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src",
    "test:pwa": "vite build && playwright test -c playwright.pwa.config.ts",
    "test:rules": "node --env-file=.env scripts/rules-live-test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "firebase": "^13.4.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "description": "Privacy-aware hybrid AI operations copilot for e-commerce teams, built on Firebase AI Logic (on-device + cloud).",
  "license": "Apache-2.0",
  "author": "Mohamed Hekal",
  "homepage": "https://bimoda.web.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedhekal/Bimoda.git"
  },
  "bugs": {
    "url": "https://github.com/mohamedhekal/Bimoda/issues"
  },
  "keywords": [
    "firebase",
    "firebase-ai-logic",
    "gemini-nano",
    "hybrid-inference",
    "on-device-ai",
    "e-commerce",
    "react",
    "pwa"
  ]
}
