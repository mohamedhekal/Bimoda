# Firebase web app config (Project settings > Your apps). These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check: reCAPTCHA Enterprise / v3 site key for production builds
VITE_APPCHECK_SITE_KEY=
# Local only: set to "true" to use an App Check debug token (register the token printed in the console). NEVER commit the token.
VITE_APPCHECK_DEBUG=false

# Optional: override the cloud model used for structured requests (default per Firebase docs for SDK v13)
# VITE_CLOUD_MODEL=

# Optional: keep cloud inference OFF until Remote Config has been fetched successfully (default: fail-open)
# VITE_CLOUD_FAIL_CLOSED=true
